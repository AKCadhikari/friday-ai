# Required for LiveKit (get free at livekit.io)
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM — pick one
OPENAI_API_KEY=your_openai_key       # if using openai
GOOGLE_API_KEY=your_google_key       # if using gemini (default)

# STT
SARVAM_API_KEY=your_sarvam_key       # if using sarvam (default STT)

# Optional
NEWSAPI_KEY=your_newsapi_key         # for news tool (free at newsapi.org)

# Providers (defaults shown)
STT_PROVIDER=sarvam      # sarvam | deepgram | openai
LLM_PROVIDER=gemini      # gemini | openai
TTS_PROVIDER=openai      # openai | sarvam

# Personality
BOSS_NAME=Boss
ASSISTANT_NAME=Friday